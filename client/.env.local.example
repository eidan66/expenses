# Analytics AI chat (server reads root + this file in dev)
# MOONSHOT_API_KEY=
# If your key is from platform.moonshot.cn (China), not platform.moonshot.ai:
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# ANALYTICS_AI_PROVIDER=moonshot
# ANALYTICS_AI_MODEL=kimi-k2.5
# Optional OpenAI-compatible API — e.g. NVIDIA NIM Kimi (integrate.api.nvidia.com) or OpenRouter:
# ANALYTICS_AI_PROVIDER=openai-compatible
# OPENAI_COMPATIBLE_BASE_URL=https://integrate.api.nvidia.com/v1
# (aliases: NVIDIA_OPENAI_BASE_URL, INTEGRATE_API_BASE_URL)
# OPENAI_COMPATIBLE_API_KEY=nvapi-...
# (aliases: NVIDIA_API_KEY, NGC_API_KEY)
# ANALYTICS_AI_MODEL=moonshotai/kimi-k2.5
# NVIDIA sample uses thinking mode; optional JSON merged into /chat/completions body:
# OPENAI_COMPATIBLE_EXTRA_BODY_JSON={"chat_template_kwargs":{"thinking":true}}
